# Salin file ini menjadi .env, lalu isi nilai sebenarnya.
# .env sudah masuk .gitignore. JANGAN commit file .env.
#
# Nilai yang mengandung spasi / tanda kutip (cookie) sebaiknya dibungkus
# dengan kutip tunggal, contoh: TIKTOK_COOKIE='a=1; b=2'

# --- Cloudflare (dipakai wrangler deploy) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Telegram ---
BOT_TOKEN=
WEBHOOK_SECRET=
PUBLIC_URL=https://bot-tele.awand795.workers.dev
OWNER_CHAT_ID=

# --- Referensi binding (nilai asli ada di wrangler.jsonc) ---
D1_DATABASE_NAME=bot-tele-db
D1_DATABASE_ID=
KV_NAMESPACE_ID=

# --- Opsional: hanya untuk testing lokal ---
# Worker secrets tetap harus diset lewat `npx wrangler secret put`.
TERABOX_COOKIE=
INSTAGRAM_COOKIE=
TIKTOK_COOKIE=
